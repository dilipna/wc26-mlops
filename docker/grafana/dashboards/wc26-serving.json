{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["wc26", "serving", "mlops"],
  "title": "WC26 Serving API",
  "uid": "wc26-serving",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "wc26-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "wc26_serving_uptime_seconds", "datasource": { "type": "prometheus", "uid": "wc26-prometheus" } }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests in flight",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "wc26-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "wc26_serving_requests_in_progress", "datasource": { "type": "prometheus", "uid": "wc26-prometheus" } }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total predictions served",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "wc26-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "sum(wc26_serving_predictions_total)", "datasource": { "type": "prometheus", "uid": "wc26-prometheus" } }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Loaded model version",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "wc26-prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^model_version$/" }, "colorMode": "none", "textMode": "name" },
      "targets": [
        { "refId": "A", "expr": "wc26_serving_model_info", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "wc26-prometheus" } }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by path (req/s, 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "wc26-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(wc26_serving_requests_total[5m]))",
          "legendFormat": "{{path}}",
          "datasource": { "type": "prometheus", "uid": "wc26-prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency (seconds): p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "wc26-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(wc26_serving_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "wc26-prometheus" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(wc26_serving_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "wc26-prometheus" }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(wc26_serving_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "wc26-prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Predictions by predicted outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "wc26-prometheus" },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (wc26_serving_predictions_total)",
          "legendFormat": "{{outcome}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "wc26-prometheus" }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "5xx error rate (req/s, 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "wc26-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "drawStyle": "line", "fillOpacity": 20 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(wc26_serving_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "datasource": { "type": "prometheus", "uid": "wc26-prometheus" }
        }
      ]
    }
  ]
}
