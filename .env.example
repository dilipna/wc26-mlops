# API-Football (direct api-football.com account, not RapidAPI) - fixtures, live scores, lineups, stats
API_FOOTBALL_KEY=

# The Odds API - live bookmaker odds
ODDS_API_KEY=

# Supabase - durable predictions/results store (supabase/schema.sql).
# Project URL + service_role key (Project Settings -> API). Leave blank to
# skip Supabase entirely -- daily_update.py falls back to CSV/JSON only.
SUPABASE_URL=
SUPABASE_KEY=

# Anthropic (Claude) API - powers the dashboard chatbot widget (PROJECT_BRAIN #8 item 2)
ANTHROPIC_API_KEY=
